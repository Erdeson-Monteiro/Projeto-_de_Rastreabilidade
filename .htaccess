# .htaccess

# Página inicial do projeto
DirectoryIndex index.php

# Segurança básica: bloqueia acesso direto à configuração, logs,
# scripts SQL, firmware e arquivos de apoio
<FilesMatch "(^config\.php|\.(txt|log|sql|sh|ino|h|md)$)">
    Require all denied
</FilesMatch>

# Evitar listagem de diretórios
Options -Indexes

# Cache para melhorar o desempenho
# (CSS e JS usam ?v=<data do arquivo>, então mudanças aparecem na hora)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Habilitar compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
